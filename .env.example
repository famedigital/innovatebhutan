# API Keys
GOOGLE_GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# Database
DATABASE_URL=your_database_url_here

# Internal API Key for webhooks
INTERNAL_API_KEY=your_secure_internal_api_key_here

# mBoB / Bhutan National QR (quotation deposit Scan & Pay)
# REQUIRED: paste EMV payload from Innovates Scan & Pay sticker (starts with 000201)
# Home-made account QRs are rejected by mBoB as "Invalid QR Code"
# Admin → Settings → Payments can upload the sticker photo to auto-decode
MBOB_STATIC_QR=
MBOB_ACCOUNT_NUMBER=203XXXXXXXX
MBOB_MERCHANT_NAME=INNOVATES
MBOB_MERCHANT_CITY=THIMPHU

# CallMeBot WhatsApp alerts (support / contact / leads)
# New bot (old bot full): add +34 623 76 13 63 to contacts, then WhatsApp
# "I allow callmebot to call me" to receive your API key.
# CALLMEBOT_PHONE = YOUR WhatsApp that receives alerts (not the bot number)
# Or set callmebot_phone / callmebot_api_key in Admin → Settings → Messaging
GST_RATE_PERCENT=5
